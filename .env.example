# ── Mantle Network ─────────────────────────────────────────
MANTLE_RPC=https://rpc.mantle.xyz
MANTLE_TESTNET_RPC=https://rpc.sepolia.mantle.xyz

# ── Trade Mode ──────────────────────────────────────────────
# Set to "false" to enable real on-chain execution (requires PRIVATE_KEY)
MOCK_MODE=true

# ── Wallet (only needed if MOCK_MODE=false) ─────────────────
PRIVATE_KEY=

# ── Signal Thresholds ────────────────────────────────────────
WHALE_THRESHOLD_USD=5000
MIN_SIGNAL_CONFIDENCE=0.65
MAX_TRADE_SIZE_USD=10000

# ── Telegram Alerts (optional) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Agent NFT (set after running scripts/deploy_agent_nft.py) ─
AGENT_NFT_ADDRESS=
AGENT_TOKEN_ID=0

# ── Agni Finance Subgraph (optional — uses mock prices if blank) ─
AGNI_SUBGRAPH=https://subgraph.mantle.xyz/subgraphs/name/agni/exchange-v3

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Misc ────────────────────────────────────────────────────
LOG_LEVEL=INFO
